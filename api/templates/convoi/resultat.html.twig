{% extends 'base.html.twig' %}

{% block title %}Résultat — DIRNO{% endblock %}

{% block content %}

<div class="section-title">
    <span class="section-num">✓</span> Résultats de la vérification
</div>

{% if statut == 'pass' %}
    <div class="banner-pass">
        <strong>✅ Convoi autorisé</strong>
        Toutes les vérifications sont conformes à la réglementation.
    </div>
{% elseif statut == 'warning' %}
    <div class="banner-warning">
        <strong>⚠️ Convoi sous réserve</strong>
        Des points d'attention ont été relevés. Vérification complémentaire recommandée.
    </div>
{% else %}
    <div class="banner-fail">
        <strong>❌ Convoi non conforme</strong>
        Des dépassements ont été détectés. Le convoi ne peut pas circuler en l'état.
    </div>
{% endif %}

{% if convoi.troncons|length > 0 %}
<div style="color:#9ca3af;font-size:0.9rem;margin-bottom:1.25rem;">
    Itinéraire :
    {% for t in convoi.troncons %}
        <strong style="color:#e5e7eb;">{{ t.route }}</strong>
        {% if t.prDebut %} PR {{ t.prDebut }}{% endif %}
        {% if t.prFin %} → {{ t.prFin }}{% endif %}
        {% if t.sens %} ({{ t.sens }}){% endif %}
        {% if not loop.last %} ▸ {% endif %}
    {% endfor %}
</div>
{% endif %}

<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
        <div class="card-title" style="margin-bottom:0;">Rapport de vérification</div>
        <button onclick="window.print()" class="btn-outline">📄 Exporter PDF</button>
    </div>

    <table>
        <thead>
            <tr>
                <th>Critère</th>
                <th>Valeur convoi</th>
                <th>Limite</th>
                <th>Statut</th>
                <th>Détail</th>
            </tr>
        </thead>
        <tbody>
            {% for check in checks %}
            <tr>
                <td><strong>{{ check.critere }}</strong></td>
                <td>{{ check.valeur }}</td>
                <td>{{ check.limite }}</td>
                <td><span class="badge-{{ check.tag }}">
                    {% if check.tag == 'ok' %}Conforme
                    {% elseif check.tag == 'ko' %}Non conforme
                    {% else %}Attention{% endif %}
                </span></td>
                <td style="color:#9ca3af;font-size:0.85rem;">{{ check.detail }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="margin-top:1rem;color:#4b5563;font-size:0.8rem;">
        Vérifié le {{ convoi.createdAt|date('d/m/Y à H:i') }}
        {% if convoi.datePassage %}
            · Passage prévu le {{ convoi.datePassage|date('d/m/Y') }}
        {% endif %}
    </div>
</div>

<div class="actions">
    <a href="{{ path('convoi_index') }}" class="btn-cta" style="max-width:220px;">← Nouvelle vérification</a>
    <a href="{{ path('convoi_historique') }}" class="btn-outline">Voir l'historique</a>
</div>

{% endblock %}