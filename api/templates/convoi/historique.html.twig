{% extends 'base.html.twig' %}

{% block title %}Historique — DIRNO{% endblock %}

{% block content %}

<div class="section-title">
    <span class="section-num">📋</span> Historique des vérifications 
</div>

{% if convois|length == 0 %}
    <div class="card" style="text-align:center;color:#9ca3af;padding:3rem;">
        Aucune vérification enregistrée pour le moment.
        <br><br>
        <a href="{{ path('convoi_index') }}" class="btn-cta" style="max-width:220px;margin:0 auto;">
            Première vérification →
        </a>
    </div>
{% else %}
    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Date</th>
                    <th>Catégorie</th>
                    <th>Masse</th>
                    <th>Largeur</th>
                    <th>Hauteur</th>
                    <th>Itinéraire</th>
                    <th>Statut</th>
                    <th>Passage prévu</th>
                </tr>
            </thead>
            <tbody>
                {% for convoi in convois %}
                <tr>
                
                    <td style="color:#4b5563;">{{ convoi.id }}</td>
                    <td>{{ convoi.createdAt|date('d/m/Y H:i') }}</td>
                    <td>Cat. {{ convoi.categorie }}</td>
                    <td>{{ convoi.masse }} t</td>
                    <td>{{ convoi.largeur }} m</td>
                    <td>{{ convoi.hauteur }} m</td>
                    <td>
                        {% for t in convoi.troncons %}
                            <span style="color:#f97316;">{{ t.route }}</span>
                            {% if not loop.last %} ▸ {% endif %}
                        {% endfor %}
                    </td>
                    <td>
                        {% if convoi.statut == 'pass' %}
                            <span class="badge-ok">Autorisé</span>
                        {% elseif convoi.statut == 'warning' %}
                            <span class="badge-warning">Sous réserve</span>
                            
                      {% else %}
                            <span class="badge-ko">Non conforme</span>
                        {% endif %}
                    </td>
                    <td style="color:#9ca3af;">
                        {% if convoi.datePassage %}
                            {{ convoi.datePassage|date('d/m/Y') }}
                        {% else %}—{% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    <div class="actions">
        <a href="{{ path('convoi_index') }}" class="btn-cta" style="max-width:220px;">← Nouvelle vérification</a>
    </div>
{% endif %}

{% endblock %}