{
    "name": "dirno/convois",
    "description": "Application de vérification de transports exceptionnels",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "doctrine/dbal": "^3.0",
        "doctrine/doctrine-bundle": "2.11",
        "doctrine/orm": "2.19",
        "nelmio/cors-bundle": "^2.6",
        "symfony/dotenv": "*",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/routing": "^7.0",
        "symfony/twig-bundle": "^7.0",
        "symfony/var-exporter": "^8.1",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
   "scripts": {
    "auto-scripts": {},
    "post-install-cmd": [],
    "post-update-cmd": []
},
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
