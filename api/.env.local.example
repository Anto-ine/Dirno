# Modèle de configuration de production.
# Copier ce fichier en « .env.local » et renseigner un secret propre à l'installation.
#
# .env.local n'est jamais versionné (voir .gitignore).

APP_ENV=prod
APP_DEBUG=0

# OBLIGATOIRE : générer une valeur unique avec
#   php -r "echo bin2hex(random_bytes(32));"
# Ce secret signe les jetons d'authentification. Ne jamais réutiliser celui d'un
# autre poste, ni laisser la valeur d'exemple.
APP_SECRET=a_remplacer_par_une_valeur_aleatoire_de_64_caracteres

# Le front étant servi par ce même serveur, aucune origine externe n'est autorisée.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
