# Valeurs par défaut pour le DÉVELOPPEMENT uniquement.
# Ce fichier est versionné : il ne doit contenir aucun secret réel.
#
# En production, .env.local (non versionné, généré au premier lancement)
# surcharge ces valeurs avec APP_ENV=prod et un APP_SECRET aléatoire.

APP_ENV=dev

# Valeur de développement, sans valeur de secret. Ne jamais réutiliser en
# production : bin/installer.php en génère une aléatoire dans .env.local.
APP_SECRET=dev-uniquement-remplace-par-env-local

DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Développement : le front Vite tourne sur un autre port que l'API.
# En production tout est servi par la même origine et le CORS ne joue plus.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
