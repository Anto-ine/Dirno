#!/usr/bin/env php
<?php

use App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Dotenv\Dotenv;

if (!is_file(dirname(__DIR__).'/vendor/autoload.php')) {
    fwrite(STDERR, "Dépendances absentes : lancez « composer install » dans le dossier api/.\n");
    exit(1);
}

require_once dirname(__DIR__).'/vendor/autoload.php';

(new Dotenv())->bootEnv(dirname(__DIR__).'/.env');

$input = new ArgvInput();
$env   = $input->getParameterOption(['--env', '-e'], $_SERVER['APP_ENV'] ?? 'dev', true);
$debug = ($_SERVER['APP_DEBUG'] ?? ($env !== 'prod')) && !$input->hasParameterOption('--no-debug', true);

$kernel = new Kernel($env, (bool) $debug);
$application = new Application($kernel);

exit($application->run($input));
