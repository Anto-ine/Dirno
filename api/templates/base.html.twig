<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}DIRNO — Transports Exceptionnels{% endblock %}</title>
    
    <style>
      <link rel="stylesheet" href="/style.css">
    </style>
</head>
<body>
    <header>
        <div class="wordmark">
            <div>
                <div>DIRNO</div>
                <div class="wordmark-sub">Transports Exceptionnels</div>
            </div>
        </div>
        <div>
            <span class="pill">Beta</span>
            <a href="{{ path('convoi_historique') }}" class="ms-3" style="color:#9ca3af;font-size:0.85rem;">Historique</a>
        </div>
    </header>

    <main class="container py-4">
        {% block content %}{% endblock %}
    </main>

    <footer>
        <span>DIRNO 2026 — Transports Exceptionnels</span>
        &nbsp;·&nbsp;
        <span>Beta 0.2 · Antoine Pechon</span>
    </footer>

    
</body>
</html>